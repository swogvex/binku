{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/credentials.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(rm:*)"
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
