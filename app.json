{
  "expo": {
    "name": "Binku",
    "slug": "binku",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "binku",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.binku.app",
      "supportsTablet": false,
      "deploymentTarget": "16.0"
    },
    "android": {
      "package": "com.binku.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          },
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "swogvexs-teams",
          "project": "binku",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear tus photocards. Las fotos se procesan en tu móvil.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir una foto de una carta que ya tengas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E5482D"
        }
      ],
      "./plugins/withDatePickerTheme"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cee89864-cf7b-4c8b-9cc9-1f82d6267c80"
      }
    },
    "owner": "swogvex"
  }
}
